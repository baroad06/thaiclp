<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/includings.ejs') %>

</head>
<body class="bg-slate-50 text-slate-900 font-kanit" data-page="contact">
  <%- include('../partials/navbar.ejs') %>
  <%- include('../partials/cover.ejs',{link: '/images/contactus/cover.jpg'}) %>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <%- include('../partials/breadcrumbs.ejs') %>
    <% if (typeof alert != 'undefined') { %>
      <div class="mb-12 bg-green-50 border border-green-200 text-green-800 px-6 py-4 rounded-2xl flex items-center space-x-3 animate-fade-in">
        <svg class="h-6 w-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <div>
          <p class="font-bold text-lg"><%= t("ส่งข้อความเรียบร้อยแล้ว") %></p>
          <p class="opacity-90"><%= t("ทีมงานจะติดต่อกลับโดยเร็ว ขอบคุณที่ติดต่อเรา") %></p>
        </div>
      </div>
    <% } %>

    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-800 mb-6">
        <%= t("ติดต่อเรา (Contact Us)") %>
      </h2>
      <div class="w-24 h-1.5 bg-blue-600 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Contact Info -->
      <div class="space-y-12">
        <div class="space-y-6">
          <div class="flex items-center space-x-4">
            <div class="bg-blue-100 p-3 rounded-xl">
              <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-800"><%= t("ที่อยู่ (Location)") %></h3>
          </div>
          <div class="pl-14 space-y-4 text-lg text-slate-600 leading-relaxed">
            <p><%= t("บริษัท ไทยชลธาร พลาส จำกัด 13 ซอยเทียนทะเล 26 แยก 2 ถนนบางขุนเทียน-ชายทะเล แขวงท่าข้าม เขตบางขุนเทียน กทม. 10150") %></p>
          </div>
        </div>

        <div class="space-y-6">
          <div class="flex items-center space-x-4">
            <div class="bg-blue-100 p-3 rounded-xl">
              <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-800"><%= t("ช่องทางการติดต่อ (Contact)") %></h3>
          </div>
          <div class="pl-14 space-y-4 text-lg text-slate-600">
            <p><span class="font-semibold text-slate-800"><%= t("เบอร์โทรศัพท์") %>:</span> 02-451-1785, 02-117-2168, 081-636-2175</p>
            <p><span class="font-semibold text-slate-800"><%= t("อีเมล") %>:</span> <a href="mailto:boonchuay@thaictp.com" class="text-blue-600 hover:underline">boonchuay@thaictp.com</a></p>
            <p><span class="font-semibold text-slate-800">LINE:</span> <a href="https://lin.ee/wY663tN" class="text-blue-600 hover:underline">@thaictp</a></p>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-slate-100">
        <h3 class="text-2xl font-bold text-slate-800 mb-8"><%= t("ส่งข้อความถึงเรา") %></h3>
        <form action="<%= prefix %>/send" method="POST" class="space-y-6">
          <div>
            <label for="email" class="block text-sm font-semibold text-slate-700 mb-2"><%= t("อีเมล") %></label>
            <input type="email" id="email" name="email" required placeholder="your@email.com"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all" />
          </div>
          <div>
            <label for="phoneNumber" class="block text-sm font-semibold text-slate-700 mb-2"><%= t("เบอร์โทรศัพท์") %></label>
            <input type="text" id="phoneNumber" name="phoneNumber" required placeholder="08X-XXX-XXXX"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all" />
          </div>
          <div>
            <label for="text" class="block text-sm font-semibold text-slate-700 mb-2"><%= t("ข้อความ") %></label>
            <textarea id="text" name="text" required rows="4" placeholder="<%= t("แจ้งสินค้า จำนวน หรือรายละเอียดที่ต้องการ") %>"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"></textarea>
          </div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-1">
            <%= t("ส่งข้อความ") %>
          </button>
        </form>
      </div>
    </div>

    <!-- Map Section -->
    <div class="mt-24 rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
      <iframe title="<%= t('แผนที่บริษัท') %>"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3877.8773914976014!2d100.42330275027255!3d13.604299704313084!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e2bac378bea603%3A0xcded25c8d2943435!2z4Lia4Lij4Li04Lip4Lix4LiXIOC5hOC4l-C4ouC4iuC4peC4mOC4suC4oyDguJ7guKXguLLguKog4LiI4Liz4LiB4Lix4LiU!5e0!3m2!1s<%= lang %>!2s<%= lang %>!4v1516528358109"
        width="100%" height="500" frameborder="0" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
  </main>

  <%- include('../partials/footer.ejs') %>
</body>
</html>
