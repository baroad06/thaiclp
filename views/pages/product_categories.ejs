<!DOCTYPE html>
<html lang="<%= lang %>"><head><%- include('../partials/includings.ejs') %></head><body class="catalog-site" data-page="products"><%- include('../partials/navbar.ejs') %><main id="main-content">
<section class="catalog-heading"><div class="site-container"><%- include('../partials/breadcrumbs.ejs') %><div class="catalog-title-row"><div><p class="eyebrow">THE PRODUCT COLLECTION</p><h1><%= t("ชิ้นส่วนที่ใช่ สำหรับงานของคุณ") %></h1><p><%= t("เลือกหมวดสินค้าที่ต้องการดู หรือค้นหาจากชื่อสินค้า") %></p></div><span class="collection-label"><%- include('../partials/icon.ejs', { name: 'box' }) %><%= countProducts(products.length) %> · <%= categories.length %> <%= t("หมวดสินค้า") %></span></div></div></section>
<div class="site-container category-overview">
  <form action="<%= prefix %>/product" method="GET" class="catalog-search-form category-overview-search" role="search"><div class="search-form"><label class="sr-only" for="catalog-search"><%= t("ค้นหาชื่อสินค้าหรือหมวดหมู่") %></label><%- include('../partials/icon.ejs', { name: 'search' }) %><input id="catalog-search" type="search" name="q" placeholder="<%= t("ค้นหาชื่อสินค้าหรือหมวดหมู่...") %>" autocomplete="off" required><button type="submit" class="button button-blue"><%= t("ค้นหา") %></button></div></form>
  <section class="category-section" aria-labelledby="category-heading"><div class="section-heading"><div><p class="eyebrow">EXPLORE OUR CATEGORIES</p><h2 id="category-heading"><%= t("เลือกสินค้าตามหมวดหมู่") %></h2></div></div>
  <%- include('../partials/category-grid.ejs') %></section>
  <div class="catalog-bottom-help"><div><strong><%= t("ต้องการขนาดหรือรูปแบบเฉพาะ?") %></strong><p><%= t("เรารับผลิตชิ้นส่วนพลาสติกตามแบบของคุณ") %></p></div><a class="text-link" href="<%= prefix %>/contactus"><%= t("ปรึกษาทีมงาน") %><%- include('../partials/icon.ejs', { name: 'arrow' }) %></a></div>
</div>
</main><%- include('../partials/footer.ejs') %></body></html>
