<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/includings.ejs') %>

</head>
<body class="bg-slate-50 text-slate-900 font-kanit" data-page="about">
  <%- include('../partials/navbar.ejs') %>
  <%- include('../partials/cover.ejs', {link: '/images/aboutus/cover.jpg' }) %>

  <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <%- include('../partials/breadcrumbs.ejs') %>
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-800 mb-6">
        <%= t("เกี่ยวกับ ไทยชลธาร พลาส") %>
      </h2>
      <div class="w-24 h-1.5 bg-blue-600 mx-auto rounded-full"></div>
    </div>

    <div class="prose prose-lg prose-slate mx-auto text-slate-600 space-y-8">
      <p class="text-xl leading-relaxed">
        &nbsp;&nbsp;&nbsp;<%= t("บริษัท ไทยชลธาร พลาส จำกัด ประกอบธุรกิจผลิตชิ้นส่วนอุปกรณ์ต่าง ๆ เช่นอุปกรณ์เฟอร์นิเจอร์ ของใช้ในครัวเรือน และอื่น ๆ ก่อตั้งขึ้นเมื่อวันที่ 17 มิถุนายน 2553 เป็นผู้รับผลิต ออกแบบ รวมถึงให้คำปรึกษาดำเนินกิจการด้วยความเชี่ยวชาญเรามุ่งมั่นที่จะพัฒนาคุณภาพสินค้าเพื่อรองรับความต้องการของลูกค้าสูงสุดจนได้รับความไว้วางใจจากลูกค้าอย่างดีเสมอมา") %>
      </p>

      <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
        <p class="text-xl leading-relaxed">
          &nbsp;&nbsp;&nbsp;<%= t("ปัจจุบัน บริษัทได้ขยายสายการผลิตเพื่อรองรับกับความต้องการของลูกค้า โดยเพิ่มการผลิตทั้งงานฉีด (Injection) และงานรีด (Extrusion) จึงสามารถผลิตชิ้นงานอุปกรณ์สินค้าต่าง ๆ ได้อย่างรวดเร็ว และควบคุมประสิทธิภาพได้ตลอดสายการผลิต ด้วยทีมงานการผลิตและออกแบบที่ชำนาญ ตลอดจนการจัดส่งตามความต้องการของลูกค้า") %>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-12 mt-16">
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-slate-800 text-center"><%= t("ใบรับรองการขึ้นทะเบียน") %></h3>
          <img class="rounded-2xl shadow-xl w-full max-w-2xl mx-auto" src="/images/etc/Certificate_of_Registration.jpg" alt="<%= t("รูปใบรับรอง") %>" />
        </div>

        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-slate-800 text-center"><%= t("โรงงานของเรา") %></h3>
          <img class="rounded-2xl shadow-xl w-full" src="/images/aboutus/1.jpg" alt="<%= t("ภาพโรงงาน") %>" />
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer.ejs') %>
</body>
</html>
