<!DOCTYPE html>
<html lang="<%= lang %>"><head><%- include('../partials/includings.ejs') %></head>
<body class="catalog-site" data-page="home">
<%- include('../partials/navbar.ejs') %>
<main id="main-content">
  <section class="home-hero"><div class="site-container hero-grid">
    <div class="hero-copy"><p class="eyebrow"><span></span>YOUR PARTNER IN EVERY PART</p><h1><%= t("ทุกชิ้นส่วน") %><br><%= t("เพื่อชิ้นงานที่") %><span><%= t("ลงตัว") %></span></h1><p class="hero-description"><%= t("โรงงานผู้ผลิตชิ้นส่วนพลาสติก อุปกรณ์เฟอร์นิเจอร์ และ อุปกรณ์รถบรรทุก") %></p>
    <form class="search-form hero-search" action="<%= prefix %>/product" method="GET" role="search"><label class="sr-only" for="home-search"><%= t("ค้นหาสินค้า") %></label><%- include('../partials/icon.ejs', { name: 'search' }) %><input id="home-search" name="q" type="search" placeholder="<%= t("ค้นหาสินค้า เช่น ลูกล้อ จุกยาง มือจับ") %>"><button type="submit" class="button button-blue"><%= t("ค้นหา") %><%- include('../partials/icon.ejs', { name: 'arrow' }) %></button></form>
    <div class="search-suggestions"><span><%= t("เลือกชม:") %></span><a href="<%= prefix %>/product/1-casters"><%= t("ลูกล้อ") %></a><a href="<%= prefix %>/product/3-furniture"><%= t("จุกยาง") %></a><a href="<%= prefix %>/product/6-bed-closet-equipment"><%= t("อุปกรณ์เฟอร์นิเจอร์") %></a></div>
    <div class="hero-proof"><span><%- include('../partials/icon.ejs', { name: 'check' }) %><%= t("ผลิตและจำหน่ายโดยตรง") %></span><span><%- include('../partials/icon.ejs', { name: 'check' }) %><%= t("รับผลิตตามแบบ") %></span></div>
    </div>
    <div class="hero-visual" data-carousel data-play-label="<%= t('เล่นสไลด์') %>" data-pause-label="<%= t('หยุดสไลด์') %>" role="region" aria-roledescription="<%= t('สไลด์โชว์') %>" aria-label="<%= t('สินค้าตัวอย่าง') %>">
      <div class="hero-image-frame">
        <% var firstSlides = ['2-caster-bearings', '7-extrusion']; var carouselCategories = firstSlides.map(function(url) { return categories.find(function(item) { return item.url === url; }); }).concat(categories.filter(function(item) { return !firstSlides.includes(item.url); })); %>
        <div class="hero-slides" data-carousel-slides aria-live="off">
          <% carouselCategories.forEach(function(category, slideIndex) { %>
          <figure class="hero-slide" data-carousel-slide role="group" aria-roledescription="<%= t('สไลด์') %>" aria-label="<%= slideIndex + 1 %> / <%= carouselCategories.length %>" <%- slideIndex ? 'hidden' : '' %>>
            <a class="hero-slide-image" href="<%= prefix %>/product/<%= category.url %>" aria-label="<%= t('ดูสินค้า') %>: <%= category.label %>"><img src="<%= categoryImages[category.url].src %>" srcset="<%= categoryImages[category.url].srcset %>" sizes="(max-width: 640px) 92vw, 44vw" alt="<%= category.label %>" <%- slideIndex ? 'loading="lazy"' : 'fetchpriority="high"' %> width="<%= categoryImages[category.url].width %>" height="<%= categoryImages[category.url].height %>"></a>
            <figcaption><a href="<%= prefix %>/product/<%= category.url %>"><strong><%= category.label %></strong><span><%= t('ดูสินค้าในหมวดนี้') %> ↗</span></a></figcaption>
          </figure>
          <% }); %>
        </div>
        <div class="carousel-controls" data-carousel-controls hidden>
          <span class="carousel-counter"><span data-carousel-current>01</span> / <%= String(carouselCategories.length).padStart(2, '0') %></span>
          <div class="carousel-dots"><% carouselCategories.forEach(function(category, slideIndex) { %><button type="button" data-carousel-dot="<%= slideIndex %>" aria-label="<%= t('ไปสไลด์') %> <%= slideIndex + 1 %>: <%= category.label %>" <%- slideIndex === 0 ? 'aria-current="true"' : '' %>></button><% }); %></div>
          <button type="button" class="carousel-toggle" data-carousel-toggle><span aria-hidden="true" data-carousel-toggle-icon>Ⅱ</span><span data-carousel-toggle-label><%= t('หยุดสไลด์') %></span></button>
          <button type="button" class="carousel-arrow carousel-previous" data-carousel-previous aria-label="<%= t('สไลด์ก่อนหน้า') %>"><%- include('../partials/icon.ejs', { name: 'arrow' }) %></button>
          <button type="button" class="carousel-arrow" data-carousel-next aria-label="<%= t('สไลด์ถัดไป') %>"><%- include('../partials/icon.ejs', { name: 'arrow' }) %></button>
        </div>
      </div>
      <div class="hero-floating-card"><span class="floating-icon"><%- include('../partials/icon.ejs', { name: 'box' }) %></span><div><strong><%= t("ชิ้นส่วนเล็ก ๆ คุณภาพที่ใส่ใจ") %></strong><span>Injection & Extrusion Solutions</span></div></div><span class="hero-corner-label">MADE FOR YOUR BUSINESS</span>
    </div>
  </div></section>
  <section class="category-section site-container" aria-labelledby="category-heading"><div class="section-heading"><div><p class="eyebrow">EXPLORE OUR CATEGORIES</p><h2 id="category-heading"><%= t("เลือกสินค้าตามหมวดหมู่") %></h2><p><%= t("เริ่มจากประเภทชิ้นส่วนที่คุณกำลังมองหา") %></p></div><a class="text-link" href="<%= prefix %>/product"><%= t("ดูสินค้า") %><%- include('../partials/icon.ejs', { name: 'arrow' }) %></a></div>
  <div class="category-grid"><% categories.forEach(function(category, index) { %><a class="category-card" href="<%= prefix %>/product/<%= category.url %>"><div class="category-image"><span class="category-index"><%= String(index + 1).padStart(2, '0') %></span><img src="<%= categoryImages[category.url].src %>" srcset="<%= categoryImages[category.url].srcset %>" sizes="(max-width: 640px) 46vw, (max-width: 960px) 44vw, 23vw" alt="<%= category.label %>" loading="lazy" width="<%= categoryImages[category.url].width %>" height="<%= categoryImages[category.url].height %>"></div><div class="category-card-bottom"><div><h3><%= category.label %></h3><span><%= countProducts(category.image.length) %></span></div><span class="round-arrow"><%- include('../partials/icon.ejs', { name: 'arrow' }) %></span></div></a><% }); %></div></section>
  <section class="service-strip"><div class="site-container service-grid"><div><span class="service-number">01</span><div><h3><%= t("เลือกชิ้นส่วนที่ต้องการ") %></h3><p><%= t("เลือกจาก 8 หมวดสินค้า พร้อมภาพประกอบ") %></p></div></div><div><span class="service-number">02</span><div><h3><%= t("สอบถามกับทีมงาน") %></h3><p><%= t("แจ้งชื่อสินค้า จำนวน และการใช้งาน") %></p></div></div><div><span class="service-number">03</span><div><h3><%= t("ให้เราช่วยดูแลงานของคุณ") %></h3><p><%= t("รับคำแนะนำและใบเสนอราคาจากผู้ผลิต") %></p></div></div></div></section>
  <section class="site-container custom-section"><div class="custom-panel"><div class="custom-copy"><p class="eyebrow">CUSTOM MANUFACTURING</p><h2><%= t("หาแบบที่ต้องการไม่เจอ?") %><br><%= t("เราช่วยผลิตให้คุณได้") %></h2><p><%= t("รับออกแบบและผลิตชิ้นส่วนพลาสติกตามความต้องการ") %><br><%= t("ทั้งงานฉีดขึ้นรูปและงานรีด ด้วยทีมงานที่พร้อมให้คำปรึกษา") %></p><a href="<%= prefix %>/contactus" class="button button-white"><%= t("ปรึกษางานผลิต") %><%- include('../partials/icon.ejs', { name: 'arrow' }) %></a></div><div class="custom-image"><img src="/images/aboutus/2.jpg" alt="<%= t("เครื่องจักรและสายการผลิตของโรงงาน") %>" loading="lazy" width="700" height="500"><span><%= t("จากความต้องการของคุณ สู่ชิ้นงานจริง") %></span></div></div></section>
</main><script src="/js/carousel.js" defer></script><%- include('../partials/footer.ejs') %></body></html>
