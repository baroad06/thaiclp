<div class="category-grid"><% categories.forEach(function(category, index) { %><a class="category-card" href="<%= prefix %>/product/<%= category.url %>"><div class="category-image"><span class="category-index"><%= String(index + 1).padStart(2, '0') %></span><img src="<%= categoryImages[category.url].src %>" srcset="<%= categoryImages[category.url].srcset %>" sizes="(max-width: 640px) 46vw, (max-width: 960px) 44vw, 23vw" alt="<%= category.label %>" loading="lazy" width="<%= categoryImages[category.url].width %>" height="<%= categoryImages[category.url].height %>"></div><div class="category-card-bottom"><div><h3><%= category.label %></h3><span><%= countProducts(category.image.length) %></span></div><span class="round-arrow"><%- include('icon.ejs', { name: 'arrow' }) %></span></div></a><% }); %></div>
