<nav class="breadcrumbs" aria-label="<%= t('เส้นทางหน้า') %>">
<% seo.breadcrumbs.forEach(function(crumb, index) { %>
  <% if (index) { %><span aria-hidden="true">/</span><% } %>
  <% if (index < seo.breadcrumbs.length - 1) { var path = new URL(crumb.url).pathname; %><a href="<%= path %>"><%= crumb.label %></a><% } else { %><span aria-current="page"><%= crumb.label %></span><% } %>
<% }); %>
</nav>
