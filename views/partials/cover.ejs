<section class="page-cover">
  <!-- Background Image with Parallax-like effect -->
  <div class="page-cover-background">
    <img src="<%= link %>" alt="Cover" class="page-cover-image" />
    <!-- Gradient Overlay for better text readability -->
    <div class="page-cover-overlay"></div>
  </div>

  <div class="page-cover-content site-container">
    <div class="max-w-2xl text-white">
      <h1 class="text-4xl md:text-6xl font-bold mb-4 animate-fade-in-up">
        <%= seo.heading %>
      </h1>
      <p class="text-lg md:text-xl text-blue-100 mb-8 opacity-90">
        <%= t("งานฉีดและงานรีดพลาสติก โดยทีมงานที่มีประสบการณ์กว่า 30 ปี") %>
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="<%= prefix %>/product" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-full font-semibold transition-all shadow-lg hover:shadow-blue-500/30">
          <%= t("สินค้า") %>
        </a>
        <a href="<%= prefix %>/aboutus" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white border border-white/30 px-8 py-3 rounded-full font-semibold transition-all">
          <%= t("เกี่ยวกับเรา") %>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>
