<% var isCategoryPage = !!activeCategory; var searchSuffix = query.trim() ? '?q=' + encodeURIComponent(query) : ''; var shown = new Set(matches.map(function(p) { return p.key; })); %>
<section class="catalog-heading"><div class="site-container"><%- include('breadcrumbs.ejs') %><div class="catalog-title-row"><div><p class="eyebrow">THE PRODUCT COLLECTION</p><h1><%= isCategoryPage ? activeCategory.label : t("ชิ้นส่วนที่ใช่ สำหรับงานของคุณ") %></h1><p><%= seo.categorySummary || t("เลือกชมชิ้นส่วนพลาสติกและอุปกรณ์เฟอร์นิเจอร์ พร้อมให้คำปรึกษาจากผู้ผลิต") %></p></div><span class="collection-label"><%- include('icon.ejs', { name: 'box' }) %><%= countProducts(products.length) %> · <%= categories.length %> <%= t("หมวดสินค้า") %></span></div></div></section>
<div class="site-container catalog-layout" data-catalog data-prefix="<%= prefix %>" data-result-label="<%= t('รายการ') %>" data-category-page="<%= isCategoryPage ? 'true' : 'false' %>">
  <aside class="catalog-sidebar"><div class="sidebar-inner"><h2><%- include('icon.ejs', { name: 'grid' }) %><%= t("หมวดหมู่สินค้า") %></h2><nav aria-label="<%= t("หมวดหมู่สินค้า") %>"><% categories.forEach(function(category) { %><a href="<%= prefix %>/product/<%= category.url %><%= searchSuffix %>" data-category-link="<%= category.url %>" class="category-nav-link <%= selectedCategory === category.url ? 'is-active' : '' %>" <%- selectedCategory === category.url ? 'aria-current="true"' : '' %>><span><%= category.label %></span><small><%= category.image.length %></small></a><% }); %></nav><div class="sidebar-help"><span class="help-icon"><%- include('icon.ejs', { name: 'chat' }) %></span><h3><%= t("ไม่แน่ใจว่าต้องใช้แบบไหน?") %></h3><p><%= t("ส่งรูปหรือตัวอย่างชิ้นงาน") %><br><%= t("ให้ทีมงานช่วยแนะนำได้เลย") %></p><a href="https://lin.ee/ldLdQC0" target="_blank" rel="noopener noreferrer"><%= t("ปรึกษาผ่าน LINE ↗") %></a></div></div></aside>
  <section class="catalog-content" aria-label="<%= t("รายการสินค้า") %>">
    <form action="<%= prefix + (isCategoryPage ? '/product/' + selectedCategory : '/product') %>" method="GET" class="catalog-search-form" role="search"><div class="search-form"><label class="sr-only" for="catalog-search"><%= t("ค้นหาชื่อสินค้าหรือหมวดหมู่") %></label><%- include('icon.ejs', { name: 'search' }) %><input id="catalog-search" type="search" name="q" placeholder="<%= t("ค้นหาชื่อสินค้าหรือหมวดหมู่...") %>" value="<%= query %>" autocomplete="off"><button type="submit" class="button button-blue"><%= t("ค้นหา") %></button></div><label class="mobile-category-label" for="category-select"><%= t("หมวดหมู่สินค้า") %></label><select id="category-select" name="category" aria-label="<%= t("เลือกหมวดหมู่สินค้า") %>"><% if (!isCategoryPage) { %><option value=""><%= t("ค้นหาทุกหมวด") %></option><% } %><% categories.forEach(function(category) { %><option value="<%= category.url %>" <%= selectedCategory === category.url ? 'selected' : '' %>><%= category.label %></option><% }); %></select></form>
    <div class="results-toolbar"><h2 id="results-title"><%= isCategoryPage ? activeCategory.label : t("ผลการค้นหา") %> <span id="result-count" aria-live="polite" aria-atomic="true"><%= countProducts(matches.length) %></span></h2><button class="clear-filters" type="button" id="clear-filters" <%- !query && !selectedCategory ? 'hidden' : '' %>><%= t("ล้างตัวกรอง") %> <span aria-hidden="true">×</span></button></div>
    <% categories.forEach(function(category) { if (category.pdfurl) { %>
    <a class="catalog-download" data-catalogue-category="<%= category.url %>" href="<%= category.pdfurl %>" target="_blank" rel="noopener noreferrer" <%- selectedCategory === category.url ? '' : 'hidden' %>><%- include('icon.ejs', { name: 'download' }) %><span class="catalog-download-label"><%= t('คลิกที่นี่เพื่อดู Catalogue') %></span><span aria-hidden="true">↗</span></a>
    <% } }); %>
    <div class="product-grid"><% products.forEach(function(item) { %><article class="product-card" data-product data-name="<%= item.name %>" data-category="<%= item.category %>" data-category-name="<%= item.categoryName %>" data-search-text="<%= item.searchText %>" <%- shown.has(item.key) ? '' : 'hidden' %>><a class="product-image" href="<%= item.image %>" target="_blank" rel="noopener noreferrer" data-preview aria-label="<%= t("ดูรูป") %> <%= item.name %>"><img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy" width="420" height="350"><span class="image-expand"><%- include('icon.ejs', { name: 'plus' }) %></span></a><div class="product-card-body"><a class="product-category" href="<%= prefix %>/product/<%= item.category %>"><%= item.categoryName %></a><h3><% item.name.split(/(\([^)]*\))/).forEach(function(part) { %><% if (part.startsWith("(")) { %><span class="product-name-phrase"><%= part %></span><% } else { %><%= part %><% } %><% }); %></h3><a class="product-inquire" href="https://lin.ee/ldLdQC0" target="_blank" rel="noopener noreferrer"><%= t("สอบถามสินค้า") %><%- include('icon.ejs', { name: 'arrow' }) %></a></div></article><% }); %></div>
    <div class="empty-results" id="empty-results" <%- matches.length ? 'hidden' : '' %>><span class="empty-icon"><%- include('icon.ejs', { name: 'search' }) %></span><h3><%= t("ยังไม่พบสินค้าที่ตรงกัน") %></h3><p><%= t("ลองใช้คำค้นที่สั้นลง หรือเลือกดูสินค้าจากหมวดอื่น") %></p><a class="button button-dark" href="<%= prefix %>/product"><%= t("ดูสินค้าทั้งหมด") %><%- include('icon.ejs', { name: 'arrow' }) %></a></div>
    <div class="catalog-bottom-help"><div><strong><%= t("ต้องการขนาดหรือรูปแบบเฉพาะ?") %></strong><p><%= t("เรารับผลิตชิ้นส่วนพลาสติกตามแบบของคุณ") %></p></div><a class="text-link" href="<%= prefix %>/contactus"><%= t("ปรึกษาทีมงาน") %><%- include('icon.ejs', { name: 'arrow' }) %></a></div>
  </section>
</div>
<dialog class="product-dialog" id="product-dialog" aria-labelledby="preview-title"><button class="icon-button dialog-close" aria-label="<%= t("ปิดรูปสินค้า") %>" autofocus><%- include('icon.ejs', { name: 'close' }) %></button><div class="preview-image-wrap"><img id="preview-image" alt=""></div><div class="preview-info"><p class="eyebrow" id="preview-category"></p><h2 id="preview-title"></h2><p><%= t("แจ้งชื่อสินค้าหรือส่งภาพนี้ให้ทีมงาน เพื่อสอบถามรายละเอียดและราคา") %></p><a class="button button-blue" href="https://lin.ee/ldLdQC0" target="_blank" rel="noopener noreferrer"><%- include('icon.ejs', { name: 'chat' }) %><%= t("สอบถามผ่าน LINE") %></a></div></dialog>
<script src="/js/catalog-search.js" defer></script><script src="/js/catalog-ui.js" defer></script>
